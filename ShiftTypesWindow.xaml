<Window x:Class="ShiftScheduler.ShiftTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift types and rules" Height="480" Width="880"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Padding="0,4" Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="90" Padding="0,4" Margin="8,0,0,0" Click="CancelButton_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Minimum rest between shifts (hours):" VerticalAlignment="Center"/>
            <TextBox x:Name="RestBox" Width="60" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Add shift" Padding="14,4" Click="AddShift_Click"/>
            <Button Content="Delete selected" Padding="14,4" Margin="8,0,0,0" Click="DeleteShift_Click"/>
            <TextBlock Text="Times: 24-hour HH:mm (End earlier than Start = overnight). Role needs: Role:Number, comma separated."
                       Foreground="Gray" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="ShiftGrid" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Start (HH:mm)" Binding="{Binding Start}" Width="110"/>
                <DataGridTextColumn Header="End (HH:mm)" Binding="{Binding End}" Width="110"/>
                <DataGridTextColumn Header="Required staff" Binding="{Binding RequiredStaff}" Width="110"/>
                <DataGridTextColumn Header="Role needs (e.g. Supervisor:1)" Binding="{Binding Roles}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
