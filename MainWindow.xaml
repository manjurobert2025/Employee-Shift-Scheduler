<Window x:Class="ShiftScheduler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift Scheduler" Height="640" Width="1250"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="10">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="PrevButton" Content="&lt; Prev" Padding="12,4" Margin="0,0,0,4" Click="PrevButton_Click"/>
            <TextBlock x:Name="WeekLabel" Margin="12,0" VerticalAlignment="Center" FontWeight="Bold" MinWidth="170"/>
            <Button x:Name="NextButton" Content="Next &gt;" Padding="12,4" Margin="0,0,0,4" Click="NextButton_Click"/>

            <Button x:Name="UndoButton" Content="Undo" Padding="12,4" Margin="30,0,0,4" IsEnabled="False" Click="UndoButton_Click"/>
            <Button Content="Clear week" Padding="12,4" Margin="8,0,0,4" Click="ClearWeek_Click"/>
            <Button Content="Copy last week" Padding="12,4" Margin="8,0,0,4" Click="CopyLastWeek_Click"/>
            <Button Content="Print..." Padding="12,4" Margin="30,0,0,4" Click="Print_Click"/>
            <Button Content="Export PDF" Padding="12,4" Margin="8,0,0,4" Click="ExportPdf_Click"/>
            <Button Content="Export Excel" Padding="12,4" Margin="8,0,0,4" Click="ExportExcel_Click"/>
            <Button Content="Auto Schedule"
        Padding="12,4"
        Margin="20,0,0,4"
        Click="AutoSchedule_Click"/>
            <MenuItem Header="Import combined workbook..."
          Click="ImportCombined_Click"/>

            <MenuItem Header="Download combined template..."
          Click="CombinedTemplate_Click"/>

            <Separator/>
            <Button x:Name="ImportButton" Content="Import / Templates" Padding="12,4" Margin="30,0,0,4" Click="ImportButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Import employees..." Click="ImportEmployees_Click"/>
                        <MenuItem Header="Import leave..." Click="ImportLeave_Click"/>
                        <MenuItem Header="Import shifts..." Click="ImportShifts_Click"/>
                        <Separator/>
                        <MenuItem Header="Download employee template..." Click="EmployeeTemplate_Click"/>
                        <MenuItem Header="Download leave template..." Click="LeaveTemplate_Click"/>
                        <MenuItem Header="Download shift template (this week)..." Click="ShiftTemplate_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <TextBox x:Name="NewEmployeeBox" Width="140" Margin="30,0,6,4" VerticalContentAlignment="Center"/>
            <Button Content="Add employee" Padding="12,4" Margin="0,0,0,4" Click="AddEmployee_Click"/>
            <Button Content="Employees..." Padding="12,4" Margin="8,0,0,4" Click="EmployeesButton_Click"/>
            <Button Content="Leave..." Padding="12,4" Margin="8,0,0,4" Click="LeaveButton_Click"/>
            <Button Content="Shift types..." Padding="12,4" Margin="8,0,0,4" Click="ShiftTypesButton_Click"/>
        </WrapPanel>

        <GroupBox DockPanel.Dock="Bottom" Header="Conflicts" Height="170" Margin="0,10,0,0">
            <ListBox x:Name="ConflictList"/>
        </GroupBox>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="RosterGrid"/>
        </ScrollViewer>
    </DockPanel>
</Window>
